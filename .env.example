# =====================================================================
#  VOCALYS : FICHIER DE CONFIGURATION
#  1) Copiez ce fichier en ".env"  (commande : cp .env.example .env)
#  2) Remplacez chaque valeur marquée  >>> À REMPLIR
#  3) NE PARTAGEZ JAMAIS le fichier .env (il contient vos clés secrètes)
#  Sur un hébergeur (Render, Railway...) : ajoutez ces mêmes lignes dans
#  la rubrique "Environment Variables" au lieu de créer le fichier.
# =====================================================================

# ---------- GÉNÉRAL ----------
NODE_ENV=production
PORT=3000
# >>> À REMPLIR : l'adresse publique de votre site, SANS "/" à la fin
# (en local : http://localhost:3000 ; en ligne : https://votre-domaine.com)
BASE_URL=http://localhost:3000
# >>> À REMPLIR : une longue chaîne aléatoire (64 caractères minimum).
# Générez-la avec :  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Dossier de la base de données SQLite et des fichiers temporaires.
# Sur Render/Railway, pointez vers le disque persistant (ex : /var/data)
DATA_DIR=./data

# ---------- IDENTITÉ DU SITE (affichée dans les pages, e-mails et textes légaux) ----------
APP_NAME=Vocalys
# >>> À REMPLIR : l'e-mail qui reçoit les messages du formulaire Contact
SUPPORT_EMAIL=support@votre-domaine.com
# >>> À REMPLIR : informations légales (pages Confidentialité, CGU, Mentions)
COMPANY_NAME=Nom de votre société
COMPANY_ADDRESS=Adresse complète, Ville, Pays
COMPANY_COUNTRY=Togo
COMPANY_REGISTRATION=Numéro RCCM / SIRET / IFU

# ---------- IA MULTIMODALE : GOOGLE GEMINI (RECOMMANDÉ) ----------
# Obtenez votre clé sur https://aistudio.google.com/app/apikey
# >>> À REMPLIR
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ---------- PAIEMENT : AGRÉGATEUR SASPAY (MOBILE MONEY & CARTES) ----------
# Créez votre compte sur https://saspay.me
# SasPay gère Wave, Orange Money, MTN MoMo, Moov Money et Cartes Visa/Mastercard.
# >>> À REMPLIR : Paramètres développeurs > Clé API secrète (sk_live_... ou sk_test_...)
SASPAY_API_KEY=
# >>> À REMPLIR : Signature secrète du Webhook configuré sur votre dashboard SasPay
# URL de webhook à déclarer chez SasPay : BASE_URL + /api/billing/webhook
SASPAY_WEBHOOK_SECRET=
SASPAY_CURRENCY=XOF

# ---------- OPTIONNEL : FALLBACK OPENAI WHISPER & STRIPE ----------
# Si vous souhaitez conserver Stripe ou OpenAI en alternative :
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1
TRANSLATE_MODEL=gpt-4o-mini

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# ---------- ESSAI GRATUIT (1 audio + 1 vidéo à l'inscription) ----------
# Durée maximale de CHAQUE fichier d'essai, en minutes
TRIAL_MAX_MINUTES=2
# Poids maximal d'un fichier d'essai, en Mo
TRIAL_MAX_FILE_MB=100
# true = l'essai n'est utilisable qu'après clic sur le lien de confirmation e-mail
TRIAL_REQUIRE_VERIFIED_EMAIL=false

# ---------- E-MAILS : SMTP ----------
# Fonctionne avec Brevo, Resend, Mailjet, Gmail (mot de passe d'application), OVH...
# Exemple Brevo : host smtp-relay.brevo.com / port 587 / identifiant + clé SMTP
# >>> À REMPLIR
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Vocalys <no-reply@votre-domaine.com>"
